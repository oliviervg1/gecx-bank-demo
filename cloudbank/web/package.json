    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
