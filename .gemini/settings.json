{
  "tools": {
    "truncateToolOutputThreshold": 0
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command|run_command",
        "hooks": [
          {
            "name": "pre-agent-push",
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/.agents/skills/cxas-agent-foundry/scripts/hooks/pre-agent-push.sh",
            "description": "Validate push target matches cloudbank/gecx-config.json before pushing to CXAS",
            "timeout": 30000
          },
          {
            "name": "pre-agent-push-lint",
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/.agents/skills/cxas-agent-foundry/scripts/hooks/pre-agent-push-lint.sh",
            "description": "Run cxas lint from the project workspace and block pushes on any error or warning",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
